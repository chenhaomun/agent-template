{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/tools/hook_guard_credentials.py\"",
            "commandWindows": "python \"$(git rev-parse --show-toplevel)/.agents/tools/hook_guard_credentials.py\"",
            "timeout": 30,
            "statusMessage": "Checking credential access policy"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/tools/hook_guard_generated.py\"",
            "commandWindows": "python \"$(git rev-parse --show-toplevel)/.agents/tools/hook_guard_generated.py\"",
            "timeout": 30,
            "statusMessage": "Checking generated-file policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/tools/hook_format_analyze.py\"",
            "commandWindows": "python \"$(git rev-parse --show-toplevel)/.agents/tools/hook_format_analyze.py\"",
            "timeout": 120,
            "statusMessage": "Formatting and analyzing edited Dart files"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/tools/session_start.py\"",
            "commandWindows": "python \"$(git rev-parse --show-toplevel)/.agents/tools/session_start.py\"",
            "timeout": 60,
            "statusMessage": "Checking project context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/tools/review_gate.py\" turn-start",
            "commandWindows": "python \"$(git rev-parse --show-toplevel)/.agents/tools/review_gate.py\" turn-start",
            "timeout": 30,
            "statusMessage": "Recording turn baseline"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/tools/review_gate.py\" stop",
            "commandWindows": "python \"$(git rev-parse --show-toplevel)/.agents/tools/review_gate.py\" stop",
            "timeout": 30,
            "statusMessage": "Checking independent review"
          }
        ]
      }
    ]
  }
}
